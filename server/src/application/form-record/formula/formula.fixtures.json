[
  { "desc": "加减乘除与优先级", "expr": "1 + 2 * 3", "expect": 7 },
  { "desc": "括号改变优先级", "expr": "(1 + 2) * 3", "expect": 9 },
  { "desc": "除法得小数", "expr": "10 / 4", "expect": 2.5 },
  { "desc": "取余", "expr": "10 % 3", "expect": 1 },
  { "desc": "一元负号", "expr": "-3 + 5", "expect": 2 },
  { "desc": "减法左结合", "expr": "10 - 2 - 3", "expect": 5 },
  { "desc": "加号拼接文本", "expr": "\"共\" + 3 + \"件\"", "expect": "共3件" },
  { "desc": "数字相加不走拼接", "expr": "1 + 2", "expect": 3 },
  { "desc": "引用值拼接文本", "expr": "$'name' + \"同学\"", "values": { "name": "小明" }, "expect": "小明同学" },
  { "desc": "字符串与空值拼接得空串", "expr": "\"\" + $'name'", "values": { "name": null }, "expect": "" },
  { "desc": "空值参与数字加法得空", "expr": "$'v' + 1", "values": { "v": null }, "expect": null },
  { "desc": "除以零得空", "expr": "1 / 0", "expect": null },
  { "desc": "对零取余得空", "expr": "5 % 0", "expect": null },
  { "desc": "空值传染算术", "expr": "$'a' * 2", "values": { "a": null }, "expect": null },
  { "desc": "数字比较大于", "expr": "3 > 2", "expect": true },
  { "desc": "数字比较小于等于", "expr": "2 <= 1", "expect": false },
  { "desc": "数字字符串按数字比较", "expr": "\"9\" < \"10\"", "expect": true },
  { "desc": "字符串按字典序比较", "expr": "\"a\" < \"b\"", "expect": true },
  { "desc": "中文字符串比较", "expr": "$'name' >= \"李\"", "values": { "name": "王" }, "expect": true },
  { "desc": "相等比较字符串化", "expr": "\"1\" == 1", "expect": true },
  { "desc": "不相等", "expr": "1 != 2", "expect": true },
  { "desc": "布尔转数字比较", "expr": "TRUE == 1", "expect": true },
  { "desc": "两个引用都空算相等", "expr": "$'x' == $'y'", "values": {}, "expect": true },
  { "desc": "布尔字面量参与算术", "expr": "TRUE + 1", "expect": 2 },
  { "desc": "IF 返回命中分支", "expr": "IF($'score' >= 60, \"及格\", \"不及格\")", "values": { "score": 75 }, "expect": "及格" },
  { "desc": "IF 只计算命中的分支", "expr": "IF(1 > 2, 1 / 0, 99)", "expect": 99 },
  { "desc": "IF 嵌套", "expr": "IF($'a' > 0, IF($'a' > 10, \"大\", \"小\"), \"零\")", "values": { "a": 5 }, "expect": "小" },
  { "desc": "数字 0 为假", "expr": "IF($'v', \"有\", \"无\")", "values": { "v": 0 }, "expect": "无" },
  { "desc": "AND 全真", "expr": "AND(1 > 0, 2 > 1)", "expect": true },
  { "desc": "AND 有假", "expr": "AND(1 > 0, 2 < 1)", "expect": false },
  { "desc": "OR 有真", "expr": "OR(1 < 0, 2 > 1)", "expect": true },
  { "desc": "OR 全假", "expr": "OR(1 < 0, 2 < 1)", "expect": false },
  { "desc": "NOT 取反", "expr": "NOT(1 > 0)", "expect": false },
  { "desc": "函数名大小写不敏感", "expr": "and(TRUE, false)", "expect": false },
  { "desc": "CONCATENATE 多参数拼接", "expr": "CONCATENATE(\"a\", 1, \"b\")", "expect": "a1b" },
  { "desc": "CONCATENATE 空引用当空串", "expr": "CONCATENATE($'first', $'last')", "values": { "first": "张", "last": null }, "expect": "张" },
  { "desc": "LEFT 从头截取", "expr": "LEFT(\"hello\", 2)", "expect": "he" },
  { "desc": "LEFT 数量超出返回全部", "expr": "LEFT(\"hi\", 10)", "expect": "hi" },
  { "desc": "RIGHT 从尾截取", "expr": "RIGHT(\"hello\", 2)", "expect": "lo" },
  { "desc": "MID 从第几位开始截取", "expr": "MID(\"hello\", 2, 3)", "expect": "ell" },
  { "desc": "LEN 字符长度", "expr": "LEN(\"你好\")", "expect": 2 },
  { "desc": "LEN 空文本为 0", "expr": "LEN(\"\")", "expect": 0 },
  { "desc": "数字隐式转文本取长度", "expr": "LEN($'num')", "values": { "num": 3 }, "types": { "num": "number" }, "expect": 1 },
  { "desc": "TEXT 数字保留两位小数", "expr": "TEXT(3.14159, \"0.00\")", "expect": "3.14" },
  { "desc": "TEXT 格式化日期", "expr": "TEXT($'dt', \"YYYY-MM-DD\")", "values": { "dt": "2026-09-11 10:30:00" }, "expect": "2026-09-11" },
  { "desc": "TEXT 格式化日期时间", "expr": "TEXT($'dt', \"YYYY-MM-DD HH:mm\")", "values": { "dt": "2026-09-11 10:30:00" }, "expect": "2026-09-11 10:30" },
  { "desc": "VALUE 文本转数字", "expr": "VALUE(\"12.5\")", "expect": 12.5 },
  { "desc": "VALUE 非数字得空", "expr": "VALUE(\"abc\")", "expect": null },
  { "desc": "VALUE 对数字原样返回", "expr": "VALUE(3.5)", "expect": 3.5 },
  { "desc": "ISEMPTY 引用缺失为真", "expr": "ISEMPTY($'v')", "values": {}, "expect": true },
  { "desc": "ISEMPTY 空字符串为真", "expr": "ISEMPTY($'v')", "values": { "v": "" }, "expect": true },
  { "desc": "ISEMPTY 有值为假", "expr": "ISEMPTY(\"x\")", "expect": false },
  { "desc": "ISEMPTY 子表列非空为假", "expr": "ISEMPTY($'sub01.f')", "values": { "sub01": [{ "f": 1 }] }, "expect": false },
  { "desc": "SUM 聚合子表列并跳过空值", "expr": "SUM($'sub01.amount')", "values": { "sub01": [{ "amount": 1 }, { "amount": 2 }, { "amount": null }] }, "expect": 3 },
  { "desc": "SUM 空子表得空", "expr": "SUM($'sub01.amount')", "values": { "sub01": [] }, "expect": null },
  { "desc": "SUM 多列摊平求和", "expr": "SUM($'sub01.a', $'sub01.b')", "values": { "sub01": [{ "a": 1, "b": 2 }, { "a": 3, "b": 4 }] }, "expect": 10 },
  { "desc": "SUM 直接对数字求和", "expr": "SUM(1, 2, 3)", "expect": 6 },
  { "desc": "SUM 忽略无法转数字的值", "expr": "SUM($'sub01.amount')", "values": { "sub01": [{ "amount": 1 }, { "amount": "x" }] }, "expect": 1 },
  { "desc": "AVERAGE 平均数", "expr": "AVERAGE($'sub01.amount')", "values": { "sub01": [{ "amount": 1 }, { "amount": 2 }, { "amount": 6 }] }, "expect": 3 },
  { "desc": "AVERAGE 全空得空", "expr": "AVERAGE($'sub01.amount')", "values": { "sub01": [{ "amount": null }] }, "expect": null },
  { "desc": "MAX 取最大", "expr": "MAX(1, 5, 3)", "expect": 5 },
  { "desc": "MIN 聚合子表列", "expr": "MIN($'sub01.amount')", "values": { "sub01": [{ "amount": 4 }, { "amount": 2 }, { "amount": null }] }, "expect": 2 },
  { "desc": "聚合参与四则运算", "expr": "SUM($'sub01.amount') * 2", "values": { "sub01": [{ "amount": 1 }, { "amount": 2 }] }, "expect": 6 },
  { "desc": "IF 中嵌套聚合", "expr": "IF(SUM($'sub01.amount') > 0, \"有\", \"无\")", "values": { "sub01": [{ "amount": 5 }] }, "expect": "有" },
  { "desc": "ROUND 保留两位小数", "expr": "ROUND(3.14159, 2)", "expect": 3.14 },
  { "desc": "ROUND 取整", "expr": "ROUND(3.7, 0)", "expect": 4 },
  { "desc": "ABS 绝对值", "expr": "ABS(-5)", "expect": 5 },
  { "desc": "ABS 正数不变", "expr": "ABS(3)", "expect": 3 },
  { "desc": "DATEDIF 按天", "expr": "DATEDIF($'d1', $'d2', \"D\")", "values": { "d1": "2026-01-01", "d2": "2026-03-01" }, "expect": 59 },
  { "desc": "DATEDIF 按月不足整月舍去", "expr": "DATEDIF($'d1', $'d2', \"M\")", "values": { "d1": "2026-01-15", "d2": "2026-03-14" }, "expect": 1 },
  { "desc": "DATEDIF 按年", "expr": "DATEDIF($'d1', $'d2', \"Y\")", "values": { "d1": "2020-05-10", "d2": "2026-05-09" }, "expect": 5 },
  { "desc": "DATEDIF 起止颠倒得空", "expr": "DATEDIF($'d1', $'d2', \"D\")", "values": { "d1": "2026-03-01", "d2": "2026-01-01" }, "expect": null },
  { "desc": "DATEDELTA 加三天", "expr": "TEXT(DATEDELTA($'d1', 3), \"YYYY-MM-DD\")", "values": { "d1": "2026-01-30" }, "expect": "2026-02-02" },
  { "desc": "DATEDELTA 减两天", "expr": "TEXT(DATEDELTA($'d1', -2), \"YYYY-MM-DD\")", "values": { "d1": "2026-03-01" }, "expect": "2026-02-27" },
  { "desc": "DATEDELTA 相减得毫秒差", "expr": "DATEDELTA($'d1', 3) - DATEDELTA($'d1', 1)", "values": { "d1": "2026-01-30" }, "expect": 172800000 },
  { "desc": "日期字符串按毫秒参与减法", "expr": "$'d2' - $'d1'", "values": { "d1": "2026-01-01", "d2": "2026-01-02" }, "expect": 86400000 },
  { "desc": "ISO 时间字符串相减", "expr": "$'d2' - $'d1'", "values": { "d1": "2026-09-11T01:59:59.000Z", "d2": "2026-09-11T02:00:00.000Z" }, "expect": 1000 },
  { "desc": "引用缺失整式得空", "expr": "$'missing' + 1", "values": {}, "expect": null },
  { "desc": "行内公式引用本行与主表字段", "expr": "$'qty' * $'price'", "row": { "qty": 2 }, "parent": { "price": 3 }, "expect": 6 },
  { "desc": "行内公式本行字段优先于主表", "expr": "$'a' + 1", "row": { "a": 10 }, "parent": { "a": 1 }, "expect": 11 },
  { "desc": "行内公式仅引用主表字段", "expr": "$'price' * 2", "row": {}, "parent": { "price": 4 }, "expect": 8 },
  { "desc": "行内公式引用子表路径得空", "expr": "$'sub01.amount'", "row": { "qty": 1 }, "parent": {}, "expect": null },
  { "desc": "收集引用按出现顺序去重", "expr": "$'b' + $'a' + $'b'", "values": { "a": 1, "b": 2 }, "expect": 5, "expectRefs": ["b", "a"] },
  { "desc": "收集子表路径引用", "expr": "SUM($'sub01.amount')", "values": { "sub01": [{ "amount": 2 }] }, "expect": 2, "expectRefs": ["sub01.amount"] },
  { "desc": "缺少右括号", "expr": "SUM($'sub01.amount'", "expectError": "syntax" },
  { "desc": "中文逗号不合法", "expr": "SUM(1，2)", "expectError": "syntax" },
  { "desc": "表达式意外结束", "expr": "1 +", "expectError": "syntax" },
  { "desc": "$ 后不是引号", "expr": "$a + 1", "expectError": "syntax" },
  { "desc": "字符串未闭合", "expr": "\"未闭合", "expectError": "syntax" },
  { "desc": "连续比较不合法", "expr": "1 < 2 < 3", "expectError": "syntax" },
  { "desc": "末尾多余内容", "expr": "1 2", "expectError": "syntax" },
  { "desc": "未知函数", "expr": "FOO(1)", "expectError": "unknown-function" },
  { "desc": "裸标识符不是函数", "expr": "foo + 1", "expectError": "unknown-function" },
  { "desc": "IF 参数个数不足", "expr": "IF(1 > 0, 2)", "expectError": "arity" },
  { "desc": "LEFT 参数个数不足", "expr": "LEFT(\"a\")", "expectError": "arity" },
  { "desc": "NOW 不接受参数", "expr": "NOW(1)", "expectError": "arity" },
  { "desc": "文本不能直接当数字用", "expr": "ROUND($'txt', 1)", "types": { "txt": "string" }, "expectTypeError": true },
  { "desc": "文本不能当逻辑条件", "expr": "NOT($'txt')", "types": { "txt": "string" }, "expectTypeError": true },
  { "desc": "文本不能当长度参数", "expr": "LEFT($'txt', \"1\")", "types": { "txt": "string" }, "expectTypeError": true },
  { "desc": "日期字段结果可直接当文本拼接", "expr": "$'d1' + \"截止\"", "values": { "d1": "2026-01-01" }, "types": { "d1": "date" }, "expect": "2026-01-01截止" }
]
